<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for Aster POS.
  Allows cleartext (HTTP/WS) traffic on local network IPs
  required for the Wi-Fi LAN sync feature.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
